rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if isAdmin();
    }
  }
}

// Important setup:
// 1. In Firestore, create collection: admins
// 2. Add document with ID = your Firebase admin user's UID
// 3. Add field: role = "admin"
// 4. Publish these rules in Firebase Console > Firestore Database > Rules.
